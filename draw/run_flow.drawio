        <mxCell id="b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="runner.js: ทำความสะอาดโค้ด (sanitize)&#xa;แล้วส่งให้ Skulpt รันในขอบเขตจำกัด" vertex="1"><mxGeometry height="60" width="290" x="155" y="130" as="geometry" /></mxCell>
